#!/bin/sh
# Pre-push (CORCO-3140, CORCO-4011). This repository's core.hooksPath=.githooks replaces
# the global hooks folder, so this file calls the owner's shared check that lives there. A
# rebase, a cherry-pick, git am or --no-verify makes a commit without .githooks/pre-commit;
# the check runs every commit the push sends that no remote holds yet through that hook,
# oldest first, and the first failing commit refuses the push. It then runs the global
# pre-push. The program is "Git hooks/check_pushed_commits.py" in the owner's Information
# Security repository, found through the global core.hooksPath as "Git hooks/repository-pre-push".
# The machine has the owner's guards, and a missing entry refuses the push as
# .githooks/pre-commit refuses the commit, when the global core.hooksPath names a folder
# that does not exist or that holds pre-commit.py (that repository's own hook entry); as in
# .githooks/pre-commit, this public repository does not look for the owner's checkout under
# HOME. Anywhere else, as in a second developer's plain clone, the owner's guards are not
# installed: the hook says so and the push goes on without that replay.
hooks=$(git config --global --includes --type=path --get core.hooksPath)
if [ -n "$hooks" ] && [ -x "$hooks/repository-pre-push" ]; then
    exec "$hooks/repository-pre-push" "$@"
fi
if [ -n "$hooks" ] && { [ ! -d "$hooks" ] || [ -f "$hooks/pre-commit.py" ]; }; then
    echo "pre-push: no shared check at '$hooks/repository-pre-push' (the global core.hooksPath), and this machine has the owner's Information Security guards, so the push was refused" >&2
    echo "pre-push: it is in the Information Security repository's 'Git hooks' folder: set the global core.hooksPath to that folder, or bring its checkout up to date with git pull --ff-only, and push again" >&2
    exit 1
fi
echo "pre-push: the owner's Information Security guards are not installed on this machine (no repository-pre-push in the global core.hooksPath), so the pushed commits were not replayed through .githooks/pre-commit" >&2
exit 0
